{% capture grid %}
  col-{{ section.settings.sm }}
  col-lg-{{ section.settings.md }}
  col-xl-{{ section.settings.lg }}
  py-{{ section.settings.py }}
  {% if section.settings.bd %}

  {% else %}

  {% endif %}
{% endcapture %}

<div class="{{ grid }} bt px-2 bx pr-4">
  <div class="row {{ section.settings.jc }} px-3 py-4 fw-bold fs-sm upper">
    {% for block in section.blocks %}
      {% if block.type == 'country' %}
        <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
          <img
            src="{{ localization.country | image_url: width: 32 }}"
            class="mr-2"
            style="width: 18px;">
          {{ localization.country.name }}
        </div>
      {% elsif block.type == 'shipping_times' %}
        <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
          {{ localization.country.market.metafields.shipping.time | append: ' DAYS' }}
        </div>
      {% elsif block.type == 'shipping_price' %}
        <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
          {{ localization.country.market.metafields.shipping.price | metafield_text | remove: cart.currency.symbol }}
        </div>
      {% elsif block.type == 'return_price' %}
        <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
          {% if localization.country.market.metafields.return.price.value > 0 %}
            {{ localization.country.market.metafields.return.price | metafield_text | remove: cart.currency.symbol }}
          {% else %}
            <span class="fs-xs">RETURN AT OWN COST</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="{{ grid }} bb mb-{{ section.settings.mb }} px-0">
  <accordion
    class="accordion bd-0"
    data-controller="accordion"
    data-accordion-persist-value="false">

    <button class="accordion-btn fs-sm bx py-2 px-3 fw-light">
      WORLD WIDE RATES
    </button>

    <div
      class="accordion-fold bx"
      data-controller="locale"
      data-locale-type-value="rates">

      {% if section.blocks.size > 0 %}

        {% if section.settings.search %}
          <input
            type="search"
            class="fm-input fm-lined px-3 accordion-btn "
            data-action="locale#onInput"
            placeholder="SEARCH">
        {% endif %}

        <div class="row {{ section.settings.jc }} px-3 py-2 fw-bold fs-sm upper">

          {% for block in section.blocks %}
            {% if block.type == 'country' %}
              <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                {{ block.settings.label }}
              </div>
            {% elsif block.type == 'shipping_times' %}
              <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                {{ block.settings.label }}
              </div>
            {% elsif block.type == 'shipping_price' %}
              <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                {{ block.settings.label }}
              </div>
            {% elsif block.type == 'return_price' %}
              <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                {{ block.settings.label }}
              </div>
            {% endif %}
          {% endfor %}

        </div>

        <div class="table-scroll px-3 pb-3" data-locale-target="countries">

          {% for country in localization.available_countries %}

            {% assign field = country.market.metafields %}

            <div
              id="{{ country.name | downcase }}"
              class="row {{ section.settings.jc }} px-1 py-1 fs-sm upper"
              {% if field.domain.subfolder != "/" %}
                data-sort-first="{% increment first %}"
              {% elsif field.zone.european_union %}
                data-sort-second="{% increment second %}"
              {% endif %}>

              {% for block in section.blocks %}
                {% if block.type == 'country' %}
                  <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                    {% if block.settings.flag %}
                      <img
                        src="{{ country | image_url: width: 32 }}"
                        class="mr-2"
                        style="width: {{ block.settings.flag_width }}px;">
                    {% endif %}
                    {{ country.name }}
                  </div>
                {% elsif block.type == 'shipping_times' %}
                  <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                    {{ field.shipping.time | append: ' DAYS' }}
                  </div>
                {% elsif block.type == 'shipping_price' %}
                  <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                    {{ field.shipping.price | metafield_text }}
                  </div>
                {% elsif block.type == 'return_price' %}
                  <div class="col-{{ block.settings.col | replace: '0', 'auto' }} {{ block.settings.ta }}">
                    {% if field.return.price.value > 0 %}
                      {{ field.return.price | metafield_text }}
                    {% else %}
                      <span style="font-size: 0.525rem;">RETURN AT OWN COST</span>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}

            </div>

          {% endfor %}

        </div>
      {% endif %}
    </div>
  </accordion>
</div>
