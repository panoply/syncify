{%
  liquid

  capture hero_overlay
    if section.settings.navbar_overlay
      echo '--hero-navbar:' | append: '-45px;'
    else
      echo '--hero-navbar:' | append: '0;'
    endif
  endcapture
%}

{% for block in section.blocks %}

  {% if block.type == 'image_annotation' %}

    {{ block.settings.hl_fw }}

  {% endif %}

  {% if block.type == 'image' or block.type == 'image_form' %}

    {%
      liquid

      capture css_vars
        echo hero_overlay
        echo '--hero-overlay:' | append: block.settings.linear_bg | append: ';'
      endcapture

      # HEADLINE STYLE
      #
      if block.settings.headline != nil
        capture headline_style
          echo 'font-size:' | append: block.settings.headline_fs | append: 'px;'
          echo 'font-weight:' | append: block.settings.headline_fw | append: ';'
          echo 'color:' | append: block.settings.headline_fc | append: ';'
        endcapture
      endif

      # HEADING STYLE
      #
      if block.settings.heading != nil
        capture heading_style
          echo 'font-size:' | append: block.settings.heading_fs | append: 'px;'
          echo 'font-weight:' | append: block.settings.heading_fw | append: ';'
          echo 'color:' | append: block.settings.heading_fc | append: ';'
        endcapture
      endif

      # CAPTION SPACING
      # Additional padding to be applied to the text content overlay container
      #
      if block.settings.gutter > 0
        assign pixels = block.settings.gutter | append: '%;'
        capture padding
          if block.settings.top
            echo 'padding-top:' | append: pixels
          endif
          if block.settings.bottom
            echo 'padding-bottom:' | append: pixels
          endif
          if block.settings.left
            echo 'padding-left:' | append: pixels
          endif
          if block.settings.right
            echo 'padding-right:' | append: pixels
          endif
        endcapture
      endif

      # ASPECT RATIO
      # The image aspect ratio to be applied on heros
      #
      capture desktop_height
        if section.settings.use_h
          echo block.settings.img_desktop.height
        else
          echo section.settings.ratio_h
        endif
      endcapture
      capture desktop_width
        if section.settings.use_w
          echo block.settings.img_desktop.width
        else
          echo section.settings.ratio_w
        endif
      endcapture
      capture mobile_height
        if section.settings.use_h
          echo block.settings.img_mobile.height
        else
          echo section.settings.ratio_h
        endif
      endcapture
      capture mobile_width
        if section.settings.use_w
          echo block.settings.img_mobile.width
        else
          echo section.settings.ratio_w
        endif
      endcapture
    %}

    <div
      class="col-12 rel"
      style="{{ css_vars }}">
      <picture
        class="ratio d-none d-md-block"
        style="--ratio: calc({{ desktop_height }} / {{ desktop_width }});">
        <source
          media="(max-width: 343px)"
          srcset="{{ block.settings.img_desktop | image_url: width: 380 }}">
        <source
          media="(min-width: 344px) and (max-width: 576px)"
          srcset="{{ block.settings.img_desktop | image_url: width: 620 }}">
        <source
          media="(min-width: 1024px) and (max-width: 1399px)"
          srcset="{{ block.settings.img_desktop | image_url: width: 3000 }}">
        <source
          media="(min-width: 1400px) and (max-width: 1799px)"
          srcset="{{ block.settings.img_desktop | image_url: width: 3000 }}">
        <source
          media="(min-width: 1800px)"
          srcset="{{ block.settings.img_desktop | image_url: width: 3000 }}">
        <img
          src="{{ block.settings.img_desktop | image_url: width: 3000 }}"
          loading="lazy"
          height="{{ block.settings.img_desktop.height }}"
          width="{{ block.settings.img_desktop.width }}">
      </picture>
      <picture
        class="ratio d-block d-md-none"
        style="--ratio: calc({{ mobile_height }} / {{ mobile_width }});">
        <source
          media="(max-width: 343px)"
          srcset="{{ block.settings.img_mobile | image_url: width: 380 }}">
        <source
          media="(min-width: 344px) and (max-width: 576px)"
          srcset="{{ block.settings.img_mobile | image_url: width: 620 }}">
        <img
          src="{{ block.settings.img_mobile | image_url: width: 3000 }}"
          loading="lazy"
          height="{{ block.settings.img_mobile.height }}"
          width="{{ block.settings.img_mobile.width }}">
      </picture>

      {% if block.type == 'image_form' %}
        <div
          class="abs-flex {{ block.settings.position }}"
          spx-component="form"
          data-form-type-value="newsletter:access"
          spx-form:klaviyo="RMim8J"
          spx-form:link="collections/${gender}-private-sale"
          spx-form:response="toggle"
          spx-form:success="Thanks for subscribing! We have sent you a confirmation email which includes access to the private sale."
          spx-morph="false"
          style="{{ padding | default: 'padding: 25px;' }}">

          <div class="hero-form flex">

            {% if block.settings.headline != blank %}
              {% capture style %}
                font-size: {{ block.settings.headline_fs }}px;
                font-weight: {{ block.settings.headline_fw }};
                color: {{ block.settings.headline_fc }};
              {% endcapture %}
              <div
                class="hero-caption d-block mb-2 tc {{ block.settings.headline_ts }}"
                style="{{ style | strip_newlines | strip }}">
                {{ block.settings.headline }}
              </div>
            {% endif %}

            <div
              class="fc-white italic my-5 mb-3 tc d-none"
              data-form-target="response">
            {% # RENDER VIRTUAL RESPONSE %}
            </div>

            <form
              method="post"
              accept-charset="UTF-8"
              class="d-flex"
              action="{{ request.path }}"
              novalidate
              data-action="form#onSubmit"
              data-form-target="form">

              <input
                type="hidden"
                name="$flow"
                class="d-none"
                value="private-sale"
                data-form-target="field">

              <p class="fc-white italic mb-5 tc">
                Shop the Fall / Winter 23 collection at 30% discount. Sale access is only available to newsletter subscribers.
              </p>

              <div>
                <div class="d-block mb-4">
                  <input
                    id="email"
                    type="email"
                    name="email"
                    class="fm-input"
                    data-action="form#onInput"
                    data-form-session="emailAddress"
                    data-form-target="field"
                    placeholder="Email address"
                    required>
                </div>
              </div>

              <div class="d-block pb-4">
                <dropdown
                  class="fm-dropdown"
                  data-controller="dropdown"
                  data-form-target="dropdown">
                  <button
                    type="button"
                    class="upper"
                    data-action="dropdown#toggle"
                    data-dropdown-target="button">
                    COLLECTION
                  </button>
                  <fieldset data-dropdown-target="collapse">
                    <label
                      for="gender-men"
                      class="upper">
                      MAN
                    </label>
                    <input
                      id="gender-men"
                      type="radio"
                      name="gender"
                      class="d-none"
                      aria-label="MAN"
                      value="M"
                      data-action="dropdown#select form#onInput"
                      data-form-target="field"
                      required>
                    <label
                      for="gender-women"
                      class="upper">
                      WOMAN
                    </label>
                    <input
                      id="gender-women"
                      type="radio"
                      name="gender"
                      class="d-none"
                      aria-label="WOMAN"
                      value="F"
                      data-action="dropdown#select form#onInput"
                      data-form-target="field">
                  </fieldset>
                </dropdown>
              </div>

              <button
                type="submit"
                class="btn w-100 py-2 btn-black bg-black"
                data-form-target="submit">
                ACCESS SALE
              </button>
            </form>
          </div>
        </div>

      {% elsif block.type == 'image' %}

        {% if block.settings.heading or block.settings.headline %}

          <div
            class="abs-flex {{ block.settings.position }}"
            style="{{ padding | default: 'padding: 25px;' }}">
            <div class="row jc-center">
              {% if block.settings.headline %}
                <h1
                  class="col-12 tc {{ block.settings.headline_ts }}"
                  style="{{ headline_style }}">
                  {{ block.settings.headline }}
                </h1>
              {% endif %}
              {% if block.settings.heading %}
                <h1
                  class="col-12 tc {{ block.settings.heading_ts }}"
                  style="{{ heading_style }}">
                  {{ block.settings.heading }}
                </h1>
              {% endif %}
            </div>
          </div>

        {% endif %}
      {% endif %}

    </div>
  {% endif %}
{% endfor %}

