{% capture columns %}
  col-{{ section.settings.xs }}
  col-sm-{{ section.settings.sm }}
  col-md-{{ section.settings.md }}
  col-lg-{{ section.settings.lg }}
  col-xl-{{ section.settings.xl }}
  col-xxl-{{ section.settings.xxl }}
  rel
{% endcapture %}

<div class="row g-{{ section.settings.px }} px-{{ section.settings.px }} py-{{ section.settings.py }} jc-center ai-center">

  {% for block in section.blocks %}

    {% liquid
      capture ratio_height
        if section.settings.use_h
          echo block.settings.img.height
        else
          echo section.settings.ratio_h
        endif
      endcapture
      capture ratio_width
        if section.settings.use_w
          echo block.settings.img.width
        else
          echo section.settings.ratio_w
        endif
      endcapture
    %}

    {% if block.type == 'image' %}

      <a href="{{ block.settings.href }}">
        <picture
          class="ratio"
          style="--ratio: calc({{ ratio_height }} / {{ ratio_width }})">
          <source
            media="(max-width: 343px)"
            srcset="{{ block.settings.img | image_url: width: 380 }}">
          <source
            media="(min-width: 344px) and (max-width: 576px)"
            srcset="{{ block.settings.img | image_url: width: 620 }}">
          <source
            media="(min-width: 1024px) and (max-width: 1399px)"
            srcset="{{ block.settings.img | image_url: width: 800 }}">
          <source
            media="(min-width: 1400px) and (max-width: 1799px)"
            srcset="{{ block.settings.img | image_url: width: 1024 }}">
          <source
            media="(min-width: 1800px)"
            srcset="{{ block.settings.img | image_url: width: 1240 }}">
          <img
            src="{{ block.settings.img | image_url: width: 1240 }}"
            loading="lazy"
            class="img-fluid">
        </picture>
      </a>

    {% elsif block.type == 'image_with_caption' %}

      <div class="{% if block.settings.full_width %}col-12 rel{% else %}{{ columns }}{% endif %} px-3">

        <picture
          class="ratio"
          style="--ratio: calc({{ ratio_height }} / {{ ratio_width }})">
          <source
            media="(max-width: 343px)"
            srcset="{{ block.settings.img | image_url: width: 380 }}">
          <source
            media="(min-width: 344px) and (max-width: 576px)"
            srcset="{{ block.settings.img | image_url: width: 620 }}">
          <source
            media="(min-width: 1024px) and (max-width: 1399px)"
            srcset="{{ block.settings.img | image_url: width: 800 }}">
          <source
            media="(min-width: 1400px) and (max-width: 1799px)"
            srcset="{{ block.settings.img | image_url: width: 1024 }}">
          <source
            media="(min-width: 1800px)"
            srcset="{{ block.settings.img | image_url: width: 1240 }}">
          <img
            src="{{ block.settings.img | image_url: width: 1240 }}"
            loading="lazy"
            class="img-fluid">
        </picture>

        <div class="d-block mt-{{ block.settings.img_mb }}">
          <a
            href="{{ block.settings.href }}"
            title="{{ block.settings.label }}"
            class="link {{ block.settings.ta }}"
            spx-position="y:0">

            {% if block.settings.heading != blank %}

            {% capture heading_style %}
              font-size: {{ block.settings.heading_fs }}px;
              font-weight: {{ block.settings.heading_fw }};
              {% if block.settings.heading_italic %}
              font-style: italic;
              {% endif %}
              {% if block.settings.heading_upper %}
              text-transform: uppercase;
              {% endif %}
              {% if block.settings.heading_upper %}
                font-variant-numeric: slashed-zero;
              {% endif %}
            {% endcapture %}

              <div
                class="d-block mb-{{ block.settings.mb }}"
                style="{{ heading_style }}">
                {{ block.settings.heading }}
              </div>

            {% endif %}

            {% if block.settings.label != blank %}

              {% capture label_style %}
                font-size: {{ block.settings.label_fs }}px;
                {% if block.settings.label_italic %}
                font-style: italic;
                {% endif %}
                {% if block.settings.label_upper %}
                text-transform: uppercase;
                {% endif %}
                font-weight: {{ block.settings.label_fw }};
                {% if block.settings.label_fv %}
                font-variant-numeric: slashed-zero;
                {% endif %}
              {% endcapture %}

              <div
                class="d-block mb-{{ block.settings.label_mb }}"
                style="{{ label_style }}">
                {{ block.settings.label }}
              </div>

            {% endif %}

            {% if block.settings.footnote != blank %}

              {% capture footnote_style %}
                font-size: {{ block.settings.footnote_fs }}px;
                {% if block.settings.footnote_italic %}
                font-style: italic;
                {% endif %}
                {% if block.settings.footnote_upper %}
                text-transform: uppercase;
                {% endif %}
                font-weight: {{ block.settings.footnote_fw }};
                {% if block.settings.footnote_upper %}
                font-variant-numeric: slashed-zero;
                {% endif %}
              {% endcapture %}

              <div
                class="d-block mb-{{ block.settings.label_mb }}"
                style="{{ footnote_style }}">
                {{ block.settings.footnote }}
              </div>

            {% endif %}
          </a>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Image Split",
  "class": "container-fluid",
  "tag": "section",
  "templates": ["index"],
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Aspect Ratio",
      "info": "Define the image ratios in the collage"
    },
    {
      "type": "number",
      "id": "ratio_h",
      "label": "Ratio Height",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "use_h",
      "label": "Use Image Height",
      "info": "Whether or not to use the native image height for aspect ratio.",
      "default": true
    },
    {
      "type": "number",
      "id": "ratio_w",
      "label": "Ratio Width",
      "default": 1240
    },
    {
      "type": "checkbox",
      "id": "use_w",
      "label": "Use Image Width",
      "info": "Whether or not to use the native image width for aspect ratio.",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid",
      "info": "Define grid layout to be rendered"
    },
    {
      "type": "range",
      "id": "xxl",
      "label": "1440px >",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "xl",
      "label": "1200px > 1439px",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "lg",
      "label": "992px > 1199px",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "md",
      "label": "768px > 991px",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "sm",
      "label": "576px > 767px",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "xs",
      "label": "0px > 575px",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Gutters",
      "info": "Customize the gutter spacing applied to label"
    },
    {
      "type": "range",
      "id": "px",
      "label": "Gutter X",
      "info": "The X (left and right) spacing gutters surrounding the label",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "py",
      "label": "Gutter Y",
      "info": "The Y (top and bottom) spacing gutters surrounding the label",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "header",
          "content": "Image",
          "info": "Select the image to show"
        },
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "href",
          "label": "Link"
        }
      ]
    },
    {
      "type": "image_with_caption",
      "name": "Image with Label",
      "settings": [
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full Width",
          "default": false,
          "info": "Whether or not the image should span full width."
        },
        {
          "type": "header",
          "content": "Image",
          "info": "Select the image to show"
        },
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Styling",
          "info": "Shared styling to be applied to either the heading and label or the label."
        },
        {
          "type": "select",
          "id": "ta",
          "label": "Text Alignment",
          "default": "tl",
          "options": [
            {
              "value": "tl",
              "label": "Left"
            },
            {
              "value": "tc",
              "label": "Center"
            },
            {
              "value": "tr",
              "label": "Right"
            }
          ]
        },
        {
          "type": "url",
          "id": "href",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "img_mb",
          "label": "Gutter Bottom",
          "info": "The bottom spacing gutter under the image",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Heading",
          "info": "Optionally define a heading to output as a headline of the label."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "checkbox",
          "id": "heading_upper",
          "label": "Uppercase",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "heading_italic",
          "label": "Italic",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "heading_fv",
          "label": "Numeric",
          "default": false
        },
        {
          "type": "range",
          "id": "heading_fs",
          "label": "Font Size",
          "min": 1,
          "max": 50,
          "step": 0.5,
          "default": 20,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "heading_fw",
          "label": "Font Weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 500
        },
        {
          "type": "range",
          "id": "heading_mb",
          "label": "Gutter Bottom",
          "info": "The bottom spacing gutter under the heading",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Label",
          "info": "Define the label text overlay for the image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "header",
          "content": "Label Style",
          "info": "Customize how the label should look"
        },
        {
          "type": "checkbox",
          "id": "label_upper",
          "label": "Uppercase",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "label_italic",
          "label": "Italic",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "label_fv",
          "label": "Numeric",
          "default": false
        },
        {
          "type": "range",
          "id": "label_fs",
          "label": "Font Size",
          "min": 1,
          "max": 50,
          "step": 0.5,
          "default": 15,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "label_fw",
          "label": "Font Weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 300
        },
        {
          "type": "range",
          "id": "label_mb",
          "label": "Gutter Bottom",
          "info": "The bottom spacing gutter under the text",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Footnote",
          "info": "Customize how the footnote text should look"
        },
        {
          "type": "text",
          "id": "footnote",
          "label": "Footnote"
        },
        {
          "type": "checkbox",
          "id": "footnote_upper",
          "label": "Uppercase",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "footnote_italic",
          "label": "Italic",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "footnote_fv",
          "label": "Numeric",
          "default": true
        },
        {
          "type": "range",
          "id": "footnote_fs",
          "label": "Font Size",
          "min": 1,
          "max": 50,
          "step": 0.5,
          "default": 15,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "footnote_fw",
          "label": "Font Weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 300
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Split",
      "category": "Image"
    }
  ]
}
{% endschema %}