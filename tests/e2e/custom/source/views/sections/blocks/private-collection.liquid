{% capture class %}
  col-{{ section.settings.mobile }}
  col-md-{{ section.settings.tablet }}
  col-xl-{{ section.settings.desktop }}
  px-{{ section.settings.gutter }}
{% endcapture %}

{% liquid
  assign private_sale = false
  assign aspect_ratio = "ratio-3000x2250"
  if collection.handle contains "private"
    assign private_sale = true
  endif
  if collection.handle contains "archive"
    assign aspect_ratio = "ratio-2048x1365"
  endif
%}

{% for block in section.blocks %}

  {% if block.type == 'monogram' %}
    <div class="ps-monogram">
      {{ block.settings.text }}
    </div>
  {% endif %}

{% endfor %}

<div class="row jc-start ac-center g-0  px-2">

  <div class="col-12 bg-mjulk tc py-5 mb-4 px-0 mx-0">
    <h2>
      PRIVATE SALE
    </h2>
    <p>
      This is a closed and private sale. Only visible through invite.
    </p>
  </div>

  {% paginate collection.products by section.settings.per_page %}

    {% for product in collection.products %}
      {% render 'product' with product
        , grid: class
        , private_sale: private_sale
        , aspect_ratio: aspect_ratio %}
    {% endfor %}

    {% if paginate.pages > 1 %}
      {% render 'paginate', paginate: paginate, anchor: '' %}
    {% endif %}

  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Private Collection",
  "tag": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Pagination",
      "info": "Products to show per page"
    },
    {
      "type": "number",
      "id": "per_page",
      "label": "Products (Per Page)",
      "default": 150
    },
    {
      "type": "header",
      "content": "Layout",
      "info": "Customize the grid layout and structure of collections"
    },
    {
      "type": "range",
      "id": "gutter",
      "label": "Gutter",
      "info": "Spacing and padding between products",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile",
      "label": "Mobile",
      "info": "Screens in mobile",
      "min": 6,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "tablet",
      "label": "Tablet",
      "info": "Screens in large tablet",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop",
      "label": "Desktop",
      "info": "Screens in laptops and desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "monogram",
      "name": "Monogram",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Monogram Background",
          "info": "Renders a monogram text to the background of the collection."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Private Sale"
        }
      ]
    },
    {
      "type": "filter",
      "name": "Filter",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Layout",
          "info": "Customize the layout and position of the collection filter."
        },
        {
          "type": "range",
          "id": "width",
          "label": "Width",
          "info": "Use 100% for stacked layout",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 15
        },
        {
          "type": "header",
          "content": "Rendering",
          "info": "Control how filters render behave when scrolling a collection."
        },
        {
          "type": "checkbox",
          "id": "sticky",
          "label": "Sticky",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}