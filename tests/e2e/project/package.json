{
  "name": "project",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "syncify": {
    "stores": {
      "syncify": {
        "dev": 136656060657
      }
    },
    "config": {
      "transform": {
        "json": {
          "stripComments": true
        },
        "script": {
          "input": "assets/script.ts",
          "format": "esm",
          "rename": "[file].min.[ext]"
        },
        "svg": {
          "snippets/icon.[file]": "assets/icons/*.svg"
        },
        "style": {
          "assets/style.css": {
            "input": "assets/style.scss",
            "sass": {
              "style": "compressed"
            }
          }
        }
      }
    }
  }
}