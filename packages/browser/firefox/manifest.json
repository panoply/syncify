{
  "manifest_version": 2,
  "name": "Syncify",
  "version": "1.0",
  "description": "Syncify CLI firefox extension for Shopify development ehancements",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "128": "images/icon-inactive-128.png"
  },
  "browser_action": {
    "default_icon": {
      "128": "images/icon-inactive-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@syncify.sh"
    }
  }
}
