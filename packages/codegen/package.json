{
  "name": "@syncify/codegen",
  "version": "0.0.1",
  "description": "Shopify GraphQL codegen handling for the sane developer.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --minify"
  },
  "author": {
    "name": "Νικολας Σαββιδης",
    "url": "https://github.com/panoply/syncify",
    "email": "n.savvidis@gmx.com"
  },
  "license": "Apache-2.0",
  "tsup": {
    "entry": [
      "./src/index.ts"
    ],
    "dts": true,
    "format": [
      "cjs"
    ],
    "target": "node20",
    "splitting": false,
    "platform": "node",
    "clean": true,
    "external": [
      "@graphql-codegen/cli",
      "@graphql-codegen/plugin-helpers",
      "@graphql-codegen/typescript",
      "@syncify/ansi",
      "prettier",
      "typescript"
    ],
    "bundle": true
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "prettier": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^5.1.0",
    "@graphql-codegen/typescript": "^4.1.5"
  }
}