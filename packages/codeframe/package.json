{
  "name": "@syncify/codeframe",
  "version": "0.0.2",
  "access": "restricted",
  "description": "Codeframe helper for Shopify Graphql API error messages.",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "dts": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --minify",
    "test": "ava --watch"
  },
  "author": {
    "name": "Νικολας Σαββιδης",
    "url": "https://github.com/panoply/syncify",
    "email": "n.savvidis@gmx.com"
  },
  "license": "Apache-2.0",
  "tsup": {
    "entry": ["./src/index.ts"],
    "dts": true,
    "format": ["cjs", "esm"],
    "treeshake": true,
    "target": "node20",
    "splitting": true,
    "platform": "node",
    "clean": true,
    "bundle": true,
    "noExternal": ["js-tokens"],
    "external": ["@syncify/ansi", "@syncify/glue"]
  },
  "dependencies": {
    "@syncify/ansi": "workspace:^",
    "@syncify/glue": "workspace:^"
  },
  "devDependencies": {
    "js-tokens": "^9.0.1"
  }
}
