{
  "npm.packageManager": "pnpm",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/CVS": true,
    "**/.ruby-lsp": true,
    "**/.vscode": false,
    "**/coverage": true,
    "**/.idea": true,
    "**/.bundle": true,
    "**/node_modules": true
  },
  "files.associations": {
    "*.json": "jsonc",
  },
  "json.schemas": [
    {
      "fileMatch": [
        "package.json"
      ],
      "url": "./.vscode/schema/tsup.json"
    },
    {
      "fileMatch": [
        "package.json"
      ],
      "url": "./.vscode/schema/syncify.json"
    }
  ],
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.quoteStyle": "single",
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "eslint.useFlatConfig": true,
  "eslint.format.enable": true,
  "eslint.onIgnoredFiles": "off",
  "stylelint.packageManager": "pnpm",
  "stylelint.enable": false,
  "stylelint.validate": [
    "scss",
    "sass",
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit"
  },
  "spx.files": [
    "./docs/src/app/**/*.ts"
  ],
  "[liquid]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "sissel.shopify-liquid"
  },
  "codesnap.showWindowControls": false,
  "codesnap.roundedCorners": true,
  "highlight.regex.regexes": [
    {
      "name": "Path Aliases ~ Prefix",
      "description": "Highlight to ~ character in path aliases",
      "languageRegex": "\\b(typescript)\\b",
      "regexes": [
        {
          "regex": "\\s\\bfrom\\s'(\\~)[a-z]",
          "regexFlag": "g",
          "regexLimit": 25000,
          "decorations": [
            {
              "index": 1,
              "color": "#E91E63",
            }
          ],
        }
      ]
    },
    {
      "name": "TS Method Preserved Colours",
      "description": "Ensures the methods that apply newlines remain highlighted",
      "languageRegex": "\\b(typescript)\\b",
      "regexes": [
        {
          "regex": "\\s+([A-Za-z]+)\\n+\\s*\\.",
          "regexFlag": "g",
          "regexLimit": 25000,
          "decorations": [
            {
              "index": 1,
              "color": "#9BDAFF",
            }
          ],
        }
      ]
    },
    {
      "name": "TS Generic Type for gql",
      "description": "Applies to the gql<Type> Literal",
      "languageRegex": "\\b(typescript)\\b",
      "regexes": [
        {
          "regex": "gql\\<([A-Za-z]+)\\.",
          "regexFlag": "g",
          "regexLimit": 25000,
          "decorations": [
            {
              "index": 1,
              "color": "#9BDAFF",
            }
          ],
        }
      ]
    },
    {
      "name": "TS Destructuring",
      "description": "Ensures the methods that apply newlines remain highlighted",
      "languageRegex": "\\b(typescript)\\b",
      "regexes": [
        {
          "regex": "\\(\\(\\{\\n([\\s\\S]*?)\\}(\\s*,\\s*[a-zA-Z]+\\s*)?\\)\\s+\\=\\>",
          "regexFlag": "g",
          "regexLimit": 25000,
          "regexes": [
            {
              "regex": "[,:]",
              "regexFlag": "g",
              "decorations": [
                {
                  "color": "#E91E63"
                }
              ]
            }
          ],
          "decorations": [
            {
              "index": 1,
              "color": "#FFAB40",
            }
          ],
        }
      ]
    }
  ],
  "vsicons.associations.files": [
    {
      "icon": "vscode",
      "format": "svg",
      "filename": true,
      "extensions": [
        "extensions.json"
      ]
    },
    {
      "icon": "svg",
      "extensions": [
        "svgo.config.js",
        "svgo.config.cjs"
      ],
      "filename": true,
      "format": "svg"
    },
    {
      "icon": "svg",
      "extensions": [
        "svgo.config.js",
        "svgo.config.cjs"
      ],
      "filename": true,
      "format": "svg"
    },
    {
      "icon": "sass",
      "extensions": [
        "sass.config.js",
        "sass.config.cjs"
      ],
      "filename": true,
      "format": "svg"
    },
    {
      "icon": "liquid",
      "extensions": [
        "syncify.config.js",
        "syncify.config.mjs",
        "syncify.config.json",
        "syncify.env.json",
        ".syncifyrc.json",
        ".syncify",
        ".syncifyrc",
        ".liquifyrc",
        ".env.syncify"
      ],
      "filename": true,
      "format": "liquid"
    },
    {
      "icon": "graphql",
      "extensions": [
        "graphql.config.yml",
        "graphql.config.ts"
      ],
      "filename": true,
      "format": "svg"
    },
    {
      "icon": "graphql_config",
      "filename": true,
      "extensions": [
        "graphql.codegen.ts"
      ]
    },
    {
      "icon": "eleventy",
      "filename": true,
      "extensions": [
        ".eleventy.cjs"
      ]
    },
    {
      "icon": "netlify",
      "filename": true,
      "extensions": [
        "_redirects"
      ]
    }
  ]
}