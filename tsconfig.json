{
  "exclude": [
    "node_modules/**/*",
    "straps",
    "dist",
    "tests",
    "tests",
    "docs",
  ],
  "include": [
    "types/**/*",
    "syncify/**/*",
  ],
  "compilerOptions": {
    "incremental": false,
    "target": "ESNext",
    "removeComments": true,
    "lib": [
      "ESNext"
    ],
    "module": "Preserve",
    "declaration": false,
    "preserveSymlinks": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "noImplicitThis": false,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "rootDir": "syncify",
    "baseUrl": ".",
    "paths": {
      /*
      /* SYNCIFY TYPES
      /* -------------------------------------------- */
      "types": [
        "./types/index.d.ts"
      ],
      "graph": [
        "./types/graph.d.ts"
      ],
      "enquirer": [
        "./types/dts/enquirer.d.ts"
      ],
      /*
      /* STATE
      /* -------------------------------------------- */
      "cli": [
        "./syncify/cli.ts"
      ],
      /*
      /* STATE
      /* -------------------------------------------- */
      "$": [
        "./syncify/model/$.ts"
      ],
      "~console": [
        "./syncify/model/console.ts"
      ],
      "modules": [
        "./syncify/model/modules.ts"
      ],
      /*
      /* HTTP
      /* -------------------------------------------- */
      "~http/*": [
        "./syncify/http/*",
      ],
      "~http/access": [
        "./syncify/http/access/index.ts",
      ],
      "~http/files": [
        "./syncify/http/files/index.ts",
      ],
      "~http/theme": [
        "./syncify/http/theme/index.ts",
      ],
      /*
      /* FILES
      /* -------------------------------------------- */
      "~file": [
        "./syncify/model/file.ts"
      ],
      "~const": [
        "./syncify/utils/const.ts"
      ],
      "~utils": [
        "./syncify/utils/utils.ts"
      ],
      "~interpolate": [
        "./syncify/cli/interpolate.ts"
      ],
      "~log": [
        "./syncify/cli/log.ts",
      ],
      "~errors": [
        "./syncify/cli/errors.ts",
      ],
      "~events": [
        "./syncify/utils/events.ts"
      ],
      /*
      /* ANSI
      /* -------------------------------------------- */
      "~prompt": [
        "./syncify/prompts/enquirer/index.ts"
      ],
      /*
      /* TRANSFORMS
      /* -------------------------------------------- */
      "~asset": [
        "./syncify/transform/asset.ts"
      ],
      "~json": [
        "./syncify/transform/json.ts"
      ],
      "~liquid": [
        "./syncify/transform/liquid.ts"
      ],
      "~pages": [
        "./syncify/transform/pages.ts.ts"
      ],
      "~schema": [
        "./syncify/transform/schema.ts",
      ],
      "~script": [
        "./syncify/transform/script.ts",
      ],
      "~style": [
        "./syncify/transform/style.ts",
      ],
      "~svg": [
        "./syncify/transform/svg.ts",
      ],
      /*
      /* DIRECTORIES
      /* -------------------------------------------- */
      "~process/*": [
        "./syncify/process/*"
      ],
      "~prompts/*": [
        "./syncify/prompts/*"
      ],
      "~transform/*": [
        "./syncify/transform/*"
      ],
      "~mode/*": [
        "./syncify/mode/*"
      ],
      "~plugins/*": [
        "./syncify/plugins/*"
      ],
      "~hot/*": [
        "./syncify/hot/*"
      ],
      "~cli/*": [
        "./syncify/cli/*.ts",
      ],
      "~help/*": [
        "./syncify/cli/help/*.ts",
      ],
      /*
      /* OPTIONS
      /* -------------------------------------------- */
      "~options/*": [
        "./syncify/options/*.ts",
      ],
      "~define/*": [
        "./syncify/options/define/*.ts",
      ],
      "~settings/*": [
        "./syncify/options/settings/*.ts",
      ],
      /*
      /* UTILITIES
      /* -------------------------------------------- */
      "~enums": [
        "./syncify/utils/enum.ts",
      ],
      "~utils/directory": [
        "./syncify/utils/directory.ts",
      ],
      "~utils/piper": [
        "./syncify/utils/piper.ts",
      ],
      "~utils/paths": [
        "./syncify/utils/paths.ts",
      ],
      "~utils/parsers": [
        "./syncify/utils/parsers.ts",
      ],
      "~utils/object": [
        "./syncify/utils/object.ts",
      ],
      "~utils/child": [
        "./syncify/utils/child.ts",
      ],
      "~utils/keychain": [
        "./syncify/utils/keychain.ts",
      ],
    }
  }
}