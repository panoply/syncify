{
  "version": "1.0.0-alpha.1",
  "name": "@syncify/cli",
  "description": "The new generation build tool for Shopify theme development.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/panoply/syncify",
  "bugs": "https://github.com/panoply/syncify/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/panoply/syncify.git"
  },
  "author": {
    "name": "Νικολας Σαββιδης",
    "url": "https://github.com/panoply",
    "email": "n.savvidis@gmx.com"
  },
  "files": [
    "dist",
    "scripts",
    "hot.js.liquid",
    "LICENCE",
    "package.json"
  ],
  "keywords": [
    "cli",
    "command line",
    "syncify",
    "shopify",
    "shopify theme",
    "shopify node",
    "shopify theme",
    "shopify sync",
    "shopify cli",
    "themekit"
  ],
  "engines": {
    "pnpm": ">=9",
    "node": ">=20",
    "vscode": "^1.22.0"
  },
  "bin": {
    "sy": "./dist/cli.js",
    "syncify": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "sy": "./bin/cli.js",
    "dev": "pnpm tsup --watch",
    "build": "pnpm --shell-mode \"./build.sh\"",
    "@cli": "tsup",
    "@utils": "pnpm -F @syncify/utils",
    "@acquire": "pnpm -F @syncify/acquire",
    "@kill": "pnpm -F @syncify/kill",
    "@docs": "pnpm -F @syncify/docs",
    "@update": "pnpm -F @syncify/update",
    "@config": "pnpm -F @syncify/config",
    "@codeframe": "pnpm -F @syncify/codeframe",
    "@glue": "pnpm -F @syncify/glue",
    "@hot": "pnpm -F @syncify/hot",
    "@ansi": "pnpm -F @syncify/ansi",
    "@turndown": "pnpm -F @syncify/turndown",
    "@json": "pnpm -F @syncify/json",
    "@timer": "pnpm -F @syncify/timer",
    "@uws": "pnpm -F @syncify/uws",
    "t:bulk-add": "tests --bulk-add snippets",
    "t:bulk-remove": "tests --bulk-remove snippets",
    "codegen": "graphql-codegen",
    "introspect": "graphql-codegen --introspect",
    "prepublishOnly": "cp assets/icon.png icon.png",
    "postpublish": "rm -rf icon.png",
    "publish:stable": "pnpm publish --tag latest",
    "publish:next": "pnpm version prerelease --preid next && pnpm publish --tag next",
    "publish:unstable": "pnpm version prerelease --preid unstable && pnpm publish --tag unstable",
    "postinstall": "node scripts/postinstall.js",
    "postversion": "node scripts/postversion.js"
  },
  "ava": {
    "typescript": {
      "rewritePaths": {
        "syncify/": "dist/tests/"
      },
      "compile": false
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": "@syncify/prettier-config",
  "dependencies": {
    "@parcel/watcher": "catalog:",
    "@syncify/codegen": "workspace:^",
    "@syncify/json": "workspace:^",
    "@syncify/turndown": "workspace:^",
    "@syncify/uws": "workspace:^",
    "adm-zip": "^0.5.16",
    "cbor": "^10.0.3",
    "clean-css": "^5.3.3",
    "enquirer": "^2.4.1",
    "esbuild": "catalog:",
    "fast-glob": "^3.3.3",
    "fs-extra": "catalog:",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "node-notifier": "^10.0.1",
    "postcss": "^8.5.3",
    "sass-embedded": "^1.85.1",
    "smol-toml": "^1.3.1",
    "svgo": "catalog:",
    "xior": "^0.7.6"
  },
  "devDependencies": {
    "@ava/typescript": "^5.0.0",
    "@changesets/cli": "^2.28.1",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.5",
    "@graphql-codegen/typescript-operations": "^4.5.1",
    "@liquify/schema": "^0.9.10",
    "@shopify/api-codegen-preset": "^1.1.5",
    "@syncify/acquire": "workspace:^",
    "@syncify/ansi": "workspace:^",
    "@syncify/codeframe": "workspace:^",
    "@syncify/config": "workspace:^",
    "@syncify/eslint-config": "workspace:^",
    "@syncify/glue": "workspace:^",
    "@syncify/kill": "workspace:^",
    "@syncify/prettier-config": "workspace:^",
    "@syncify/tests": "workspace:^",
    "@syncify/timer": "workspace:^",
    "@syncify/types": "workspace:^",
    "@syncify/update": "workspace:^",
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/node-notifier": "^8.0.5",
    "@types/write-file-atomic": "^4.0.3",
    "anymatch": "^3.1.3",
    "ava": "^6.2.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "catalog:",
    "gqlmin": "^0.2.2",
    "p-map": "^7.0.3",
    "p-queue": "^8.1.0",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "tree-kill": "^1.2.2",
    "tsconfig-type": "catalog:",
    "tsup": "^8.3.0",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "write-file-atomic": "^6.0.0",
    "write-package": "^7.1.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.15"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}