<!DOCTYPE html>
<html lang="en">
  <head>
    <title>
      {{- title | prepend: 'Syncify | ' -}}
    </title>
    {%- include 'head' -%}
    <script
      src="{{'/bundle.min.js' | url }}"
      spx-eval="false"
      defer></script>
  </head>
  <body>
    {%- if page.url == '/' -%}
      {%- include 'include/landing' -%}
    {%- else -%}
      {%- include 'include/navbar' -%}
      <div class="container-fluid container-wrapper">
        {%- include 'include/sidebar' -%}
        <div
          id="content"
          class="row jc-center {% if anchors %}jc-md-around{% else %}jc-md-start pl-4{% endif %} content-offset">
          <main class="col-12 col-sm-11 col-lg-9 pb-4">
            {%- include 'include/breadcrumb' -%}
            {{- content -}}
            {%- include 'include/paginate' -%}
          </main>
          {%- if anchors -%}
            <div
              class="col-auto anchors d-none d-sm-unset"
              spx-component="scrollspy"
              spx-scrollspy:class="fc-green">
              <ul>
                {%- for name in anchors -%}
                  <li>
                    <a
                      href="{{ name | anchor }}"
                      spx-node="scrollspy.href">
                      {{- name -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>

    {%- endif -%}
    {%- sprite -%}
    {%- search 'syncify' -%}

  </body>
</html>