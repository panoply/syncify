<section class="pt-4 pb-5 px-sm-3">
  {%- if prev and next -%}

    <div class="row jc-between mt-5 mb-3 navigators">

      <a
        href="{{ prev.url | url }}"
        class="col-auto btn prev tl px-3 px-sm-4 py-2  "
        spx-scroll="0">
        <small class="d-block fc-gray d-none">Previous</small>
        {%- svg 'chevron-left', 'icon icon-left mr-1' -%}
        {{- prev.title -}}
      </a>

      <a
        class="col-auto btn next tr px-3 px-sm-4 py-2 ml-auto"
        href="{{ next.url | url }}"
        spx-scroll="0">
        <small class="d-block fc-gray d-none">Next</small>
        {{- next.title -}}
        {%- svg 'chevron-right', 'icon icon-right ml-1' -%}
      </a>

    </div>

  {%- else -%}

    {%- for item in navigation.docs -%}

      {%- assign menu_index = forloop.index -%}
      {%- assign menu_last = forloop.last -%}

      {%- for link in item.links -%}

        {%- liquid
          #
          # SKIP LINKS
          #
          unless link.url == page.url
            continue
          endunless
          #
          # PREV AND NEXT LINKS
          #
          if link.url == page.url
            #
            # PREV LINK
            #
            if forloop.first
              assign prev_index = menu_index | minus: 2
              assign prev = navigation.docs[prev_index].links | last
            else
              assign prev_link = forloop.index0 | minus: 1
              assign prev = item.links[prev_link]
            endif
            #
            # NEXT LINK
            #
            if menu_last and forloop.last
              assign next = navigation.docs[0].links | first
            elsif forloop.last
              assign next = navigation.docs[menu_index].links | first
            else
              assign next_index = forloop.index0 | plus: 1
              assign next = item.links[next_index]
            endif

          endif
        -%}

        <div class="row jc-between mt-5 mb-3 navigators">
          {%- unless menu_index == 1 and forloop.index == 1 -%}
            <a
              href="{{ prev.url | url }}"
              class="col-auto btn prev tl px-3 px-sm-4 py-2  "
              spx-scroll="0">
              <small class="d-block fc-gray d-none">Previous</small>
              {%- svg 'chevron-left', 'icon icon-left mr-1' -%}
              {{- prev.title -}}
            </a>
          {%- endunless -%}

          <a
            class="col-auto btn next tr px-3 px-sm-4 py-2 ml-auto"
            href="{{ next.url | url }}"
            spx-scroll="0">
            <small class="d-block fc-gray d-none">Next</small>
            {{- next.title -}}
            {%- svg 'chevron-right', 'icon icon-right ml-1' -%}
          </a>

        </div>

        {%- break -%}

      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
</section>