<video
  class="d-none d-md-unset"
  width="100%"
  height="{{ height }}px"
  autoplay="true"
  loop="true"
  muted="true"
  style="border: 0.01rem solid #363d49;border-radius: 0.5em;padding:0 10px;background-color: #0e0e0e;">
  <source
  src="https://brixtol.cloud/open-source/{{ video }}.mp4"
  type="video/mp4">
</video>